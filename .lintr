# House lint configuration.
#
# line_length 135 rather than lintr's 80. The sibling packages raise it to
# 100-120 for aligned-argument calls; this one needs more for a different
# reason. `hvti_taxonomy()` is a data table written as code -- 42 rows of
# prefix / name / folder / description, column-aligned so the prefix system
# can be read down the page. Wrapping it to 80 would destroy the alignment,
# which is the only thing that makes 42 rows legible. The widest row is 132
# characters; 135 leaves a little room without inviting drift.
#
# Everything else is lintr's default and IS enforced -- commas, infix spaces,
# braces, semicolons, object naming, object usage, trailing blank lines.
# In particular commas_linter stays on: it caught two taxonomy rows whose
# column alignment had slipped, which is exactly the defect it exists for.
linters: linters_with_defaults(
    line_length_linter = line_length_linter(135L)
  )
# `inst/templates/` is shipped data, not package source, and three default
# linters are wrong for it.
#
# `object_usage_linter` can never pass there: the templates call
# `TemporalHazard` and `hvtiRutilities`, which are the *study's* dependencies
# and deliberately absent from DESCRIPTION, so a CI runner has no copy and
# every call reports "no visible global function". lintr says as much itself --
# "there is no package called ... This may lead to false positives."
#
# `object_name_linter` fires on the templates' edit-here constants -- CLEVEL,
# TIME, STATUS, DERIVED, INTERNAL_COLS, UNKNOWN. Those are SCREAMING_CASE on
# purpose, so a study author copying the file sees at a glance what to change,
# and CLEVEL carries the name of the SAS macro parameter it replaces.
# snake_case would hide the very thing the template exists to advertise.
#
# `commented_code_linter` fires on instructional scaffolding
# (`# d <- read_built()`) -- the template showing its user what to uncomment.
#
# Indentation and braces stay ON here deliberately: a file people copy should
# be exemplary in its layout.
#
# ⚠️ These keys are PATHS, so renaming a template or its directory silently
# orphans its entry and the excluded linters come back. Renaming the nine
# templates and their directories on 2026-09-03 took the count from 0 to 86
# lints in one step. If a rename ever shows a lint spike, look here first.
#
# The key is the FILE, not the directory `inst/templates`. A directory key
# excludes every linter on that path wholesale and silently -- with it, the six
# real indentation/brace lints in ac.qmd disappeared from a clean run. Only a
# file key honours the per-linter list. A new template therefore needs its own
# entry here, which is the right amount of friction: it forces a decision per
# template rather than blanket-exempting the directory.
exclusions: list(
    "inst/templates/20_distributions/ac.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/20_distributions/hz.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/40_graphs/hp.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/40_graphs/hs.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/30_analyses/hm.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/30_analyses/bl.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/30_analyses/br.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/30_analyses/bc.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    ),
    "inst/templates/30_analyses/bh.qmd" = list(
      object_name_linter = Inf,
      commented_code_linter = Inf,
      object_usage_linter = Inf
    )
  )
